# ─────────────────────────────────────────────────────────────
#  InWardOut website: environment variables
#  Copy to .env for local development. Never commit real values.
#  On Vercel: Project → Settings → Environment Variables.
#  Changes take effect after a new build/deploy.
# ─────────────────────────────────────────────────────────────

# Real production domain, with protocol and no trailing slash.
# Leave empty until the domain is confirmed. Without it there are
# no canonical URLs and no sitemap, and every page is noindex.
SITE_URL=

# Search engine indexing. Only takes effect when SITE_URL is set.
# Keep false for demos and previews. Set to true for production only.
PUBLIC_ALLOW_INDEXING=false

# Optional external booking link (e.g. a scheduling page).
# When set, the primary CTA links there instead of /contact.
PUBLIC_BOOKING_URL=

# Vercel Web Analytics (cookieless). Off by default.
# Also enable Web Analytics in the Vercel dashboard before switching on.
PUBLIC_ANALYTICS_ENABLED=false

# ── Contact form (server-side only; never exposed to the browser) ──
# Choose one provider. If nothing valid is configured, the form is shown
# but sending is disabled and the page says the form is not active yet.
# Optional: force a provider ("resend" or "webhook"). Auto-detected otherwise.
CONTACT_PROVIDER=

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
# Address that receives the requests
CONTACT_TO_EMAIL=
# Verified sender, e.g. "InWardOut website <website@your-domain>"
CONTACT_FROM_EMAIL=

# Option B: POST JSON to a form service or automation webhook
# (e.g. Formspree, Make, Zapier, n8n). Must return a 2xx status.
CONTACT_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>"
CONTACT_WEBHOOK_TOKEN=

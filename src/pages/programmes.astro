---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PrimaryCta from '../components/PrimaryCta.astro';
import CtaLink from '../components/CtaLink.astro';
import InvestmentNote from '../components/InvestmentNote.astro';
import OrganicShape from '../components/OrganicShape.astro';
import ClosingInvitation from '../components/ClosingInvitation.astro';
import { getContent } from '../content';
import { programmes, groupSessions } from '../data/programmes';
import { routes } from '../data/settings';

const { programmesPage: page, programmeCopy, site } = getContent();
const labels = page.labels;
const [online, combined] = [programmeCopy.online, programmeCopy['online-bodywork']];
---

<BaseLayout title={page.meta.title} description={page.meta.description}>
  <PageHero eyebrow={page.hero.eyebrow} title={page.hero.title} lead={page.hero.lead} shape="pebble">
    <PrimaryCta cta="programmes-hero-primary" />
  </PageHero>

  <!-- The two programmes -->
  {
    programmes.map((p, i) => {
      const copy = programmeCopy[p.id];
      const dark = i === 1;
      return (
        <section
          id={p.id}
          class:list={['relative isolate overflow-hidden py-section', dark ? 'on-dark bg-forest text-sage' : 'bg-ivory']}
          aria-labelledby={`${p.id}-title`}
        >
          {dark && <OrganicShape variant="ripple" class="absolute -top-36 -left-36 -z-10 w-[32rem] text-sand/15" />}
          <div class="container-page grid gap-14 lg:grid-cols-12">
            <header class="lg:col-span-5">
              <p aria-hidden="true" class:list={['font-display text-7xl leading-none', dark ? 'text-sand/70' : 'text-copper']}>
                0{i + 1}
              </p>
              <h2 id={`${p.id}-title`} class:list={['mt-6 text-display-lg', dark && 'text-ivory']}>
                {copy.name}
              </h2>
              <p class:list={['mt-4 font-display text-display-sm italic', dark ? 'text-sand-light' : 'text-moss']}>{copy.tagline}</p>

              <dl class:list={['mt-10 grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 border-t pt-6', dark ? 'border-sand/25' : 'border-forest/15']}>
                <dt class:list={['eyebrow pt-1', dark ? 'text-sand' : 'text-copper-ink']}>{labels.duration}</dt>
                <dd>{labels.weeks(p.weeks)}</dd>
                <dt class:list={['eyebrow pt-1', dark ? 'text-sand' : 'text-copper-ink']}>{labels.online}</dt>
                <dd>{labels.onlineSessions(p.onlineSessions)}</dd>
                <dt class:list={['eyebrow pt-1', dark ? 'text-sand' : 'text-copper-ink']}>{labels.inPerson}</dt>
                <dd>{p.bodyworkSessions > 0 ? labels.bodyworkSessions(p.bodyworkSessions) : labels.notIncluded}</dd>
              </dl>

              <InvestmentNote programme={p} tone={dark ? 'dark' : 'light'} class="mt-8" />
            </header>

            <div class="space-y-12 lg:col-span-6 lg:col-start-7">
              <div>
                <h3 class:list={['eyebrow font-sans', dark ? 'text-sand' : 'text-copper-ink']}>{labels.suitedFor}</h3>
                <ul class="mt-5 space-y-4">
                  {copy.suitedFor.map((s) => (
                    <li class="flex gap-4">
                      <span aria-hidden="true" class:list={['mt-[0.85em] h-px w-5 shrink-0', dark ? 'bg-sand/70' : 'bg-copper']} />
                      <span class:list={[dark ? 'text-ivory' : 'text-forest']}>{s}</span>
                    </li>
                  ))}
                </ul>
              </div>
              {(
                [
                  [labels.content, copy.content],
                  [labels.rhythm, copy.rhythm],
                  [labels.collaboration, copy.collaboration],
                  ...(copy.practical ? [[labels.practical, copy.practical]] : []),
                ] as [string, string][]
              ).map(([heading, text]) => (
                <div class:list={['border-t pt-6', dark ? 'border-sand/20' : 'border-forest/15']}>
                  <h3 class:list={['eyebrow font-sans', dark ? 'text-sand' : 'text-copper-ink']}>{heading}</h3>
                  <p class="mt-3">{text}</p>
                </div>
              ))}
              {groupSessions.publish && groupSessions.description && <p class="border-t pt-6">{groupSessions.description}</p>}
              <PrimaryCta cta={`programmes-${p.id}-primary`} tone={dark ? 'dark' : 'light'} />
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- Comparison -->
  <section class="py-section" aria-labelledby="comparison-title">
    <div class="container-page">
      <SectionHeading id="comparison-title" eyebrow={page.comparison.eyebrow} title={page.comparison.title} />

      <!-- Desktop/tablet: aligned rows. Mobile: stacked per aspect. -->
      <div class="mt-14 border-t border-forest/20">
        <div class="hidden grid-cols-12 gap-8 border-b border-forest/15 py-5 md:grid" aria-hidden="true">
          <span class="col-span-4"></span>
          <span class="col-span-4 font-display text-display-sm">{online.name}</span>
          <span class="col-span-4 font-display text-display-sm">{combined.name}</span>
        </div>
        <dl>
          {
            page.comparison.rows.map((row) => (
              <div class="grid gap-3 border-b border-forest/15 py-6 md:grid-cols-12 md:gap-8">
                <dt class="eyebrow pt-1 text-copper-ink md:col-span-4">{row.label}</dt>
                <dd class="md:col-span-4">
                  <span class="block text-sm text-moss md:hidden">{online.name}</span>
                  <span class="sr-only max-md:hidden">{online.name}: </span>
                  {row.online}
                </dd>
                <dd class="md:col-span-4">
                  <span class="block text-sm text-moss md:hidden">{combined.name}</span>
                  <span class="sr-only max-md:hidden">{combined.name}: </span>
                  {row.combined}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Tailoring + after three months -->
  <div class="bg-linen py-section">
    <div class="container-page grid gap-16 md:grid-cols-2 md:gap-12 lg:gap-20">
      {
        [page.tailoring, page.afterwards].map((block) => (
          <section>
            <h2 class="text-display-md">{block.title}</h2>
            <span aria-hidden="true" class="mt-6 block h-px w-12 bg-copper" />
            <div class="prose-body mt-6 text-moss">
              {block.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <!-- Choosing -->
  <section class="container-page pt-section text-center" aria-labelledby="choosing-title">
    <h2 id="choosing-title" class="text-display-md">{page.choosing.title}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lead text-moss">{page.choosing.text}</p>
    <div class="mt-8">
      <CtaLink href={routes.faq} variant="text" cta="programmes-choosing-faq">{site.cta.faq}</CtaLink>
    </div>
  </section>

  <ClosingInvitation title={page.closing.title} text={page.closing.text} cta="programmes-closing-primary" />
</BaseLayout>

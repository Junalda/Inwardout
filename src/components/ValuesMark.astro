---
/** Typographic DEPTH — TRUST — VITALITY accent. */
interface Props {
  tone?: 'light' | 'dark';
  direction?: 'row' | 'column';
  class?: string | undefined;
}
const { tone = 'light', direction = 'row', class: className = '' } = Astro.props;
const words = ['Depth', 'Trust', 'Vitality'];
---

<p
  class:list={[
    'font-display uppercase tracking-[0.28em]',
    direction === 'row' ? 'flex flex-wrap items-center gap-x-4 gap-y-2' : 'flex flex-col gap-3',
    tone === 'light' ? 'text-forest' : 'text-sand-light',
    className,
  ]}
>
  {
    words.map((w, i) => (
      <>
        {i > 0 && (
          <span aria-hidden="true" class:list={['block bg-copper', direction === 'row' ? 'h-px w-8' : 'h-8 w-px ml-1']} />
        )}
        <span>{w}</span>
      </>
    ))
  }
</p>

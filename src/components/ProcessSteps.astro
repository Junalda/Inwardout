---
interface Props {
  steps: readonly { title: string; text: string }[];
  tone?: 'light' | 'dark';
}
const { steps, tone = 'light' } = Astro.props;
---

<ol class="relative grid gap-12 md:grid-cols-3 md:gap-10">
  <span
    aria-hidden="true"
    class:list={['absolute top-6 left-6 hidden h-px md:block', tone === 'light' ? 'bg-forest/20' : 'bg-sand/30']}
    style="right: calc(33.333% - 1.5rem)"
  ></span>
  {
    steps.map((step, i) => (
      <li class="relative">
        <span
          aria-hidden="true"
          class:list={[
            'relative flex h-12 w-12 items-center justify-center rounded-full border font-display text-xl',
            tone === 'light' ? 'border-copper bg-ivory text-copper-ink' : 'border-sand/60 bg-forest text-sand',
          ]}
        >
          {i + 1}
        </span>
        <h3 class:list={['mt-6 text-display-sm', tone === 'dark' && 'text-ivory']}>
          {step.title}
        </h3>
        <p class:list={['mt-3 max-w-sm', tone === 'light' ? 'text-moss' : 'text-sage']}>{step.text}</p>
      </li>
    ))
  }
</ol>

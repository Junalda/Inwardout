---
import type { HTMLAttributes } from 'astro/types';
import { getContent } from '../content';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  /** Stable identifier for (optional) analytics, e.g. "home-hero-primary". */
  cta: string;
  variant?: 'primary' | 'secondary' | 'text';
  tone?: 'light' | 'dark';
  external?: boolean;
  class?: string | undefined;
}

const { href, cta, variant = 'primary', tone = 'light', external = false, class: className = '', ...rest } = Astro.props;
const { site } = getContent();

const base =
  'group inline-flex items-center justify-center gap-3 text-[0.98rem] font-medium leading-snug transition-colors duration-300 ease-[var(--ease-calm)]';

const styles = {
  primary: {
    light: 'rounded-full bg-forest px-7 py-4 text-ivory-light hover:bg-forest-deep text-center',
    dark: 'rounded-full bg-sand-light px-7 py-4 text-forest-deep hover:bg-ivory text-center',
  },
  secondary: {
    light: 'rounded-full border border-forest/35 px-7 py-[calc(1rem-1px)] text-forest hover:border-forest hover:bg-forest/5 text-center',
    dark: 'rounded-full border border-sand/50 px-7 py-[calc(1rem-1px)] text-ivory hover:border-sand hover:bg-ivory/5 text-center',
  },
  text: {
    light: 'text-forest link-underline',
    dark: 'text-ivory link-underline',
  },
} as const;
---

<a
  href={href}
  data-cta={cta}
  class:list={[base, styles[variant][tone], className]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  {...rest}
>
  <span><slot /></span>
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    width="18"
    height="18"
    class="shrink-0 transition-transform duration-300 ease-[var(--ease-calm)] group-hover:translate-x-0.5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"><path d="M4 10h11M11 5.5 15.5 10 11 14.5"></path></svg>
  {external && <span class="sr-only">{site.a11y.externalLink}</span>}
</a>
